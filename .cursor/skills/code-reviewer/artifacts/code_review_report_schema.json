{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeReviewReport",
  "type": "object",
  "required": [
    "summary",
    "criticalIssues",
    "majorIssues",
    "minorIssues",
    "positiveFeedback",
    "questions",
    "verdict"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "criticalIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "description",
          "recommendation"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical"
            ]
          },
          "owasp": {
            "type": "string",
            "description": "OWASP Top 10 mapping if applicable"
          },
          "recommendation": {
            "type": "string"
          },
          "exampleFix": {
            "type": "string"
          }
        }
      }
    },
    "majorIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "description",
          "recommendation"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "major"
            ]
          },
          "recommendation": {
            "type": "string"
          },
          "exampleFix": {
            "type": "string"
          }
        }
      }
    },
    "minorIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "description",
          "recommendation"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor"
            ]
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "positiveFeedback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "request_changes",
        "comment"
      ]
    },
    "tests": {
      "type": "object",
      "description": "Optional test coverage and suggestions",
      "properties": {
        "coverageSummary": {
          "type": "string"
        },
        "missingCases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestedTests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional review metadata",
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "repository": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "description": "PR number or commit SHA"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
