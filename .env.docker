APP_NAME=Ticket Management Backend
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DB_HOST=postgres
DB_PORT=5432
DB_NAME=ticket_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DB_ECHO=false

AUDIO_UPLOAD_PATH=/app/uploads/audio
SEED_CLIENTS_ENABLED=true
SEED_CLIENT_TOKEN_BYTES=32
CLIENT_TOKEN_HASH_ALGORITHM=sha256
